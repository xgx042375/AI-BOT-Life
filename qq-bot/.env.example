# ============================================================================
# QQAI 陪伴框架 · 环境配置样例
#
# 用法：复制为 .env 后按需修改（.env 不入库）。全部键都有缺省值——
#       不写 = 用下面注释里的缺省，写错 ≠ 崩，最坏情况是该功能保持缺省。
# 生效：改完**重启 bot**（部分项重启启动器即可，见各项说明）。
# ============================================================================

# ---- NoneBot2 基础 ----
HOST=127.0.0.1
PORT=8080
# 管理员/主理人 QQ 号。**必须是 JSON 数组**（写成裸数字会让 bot 起不来）：
SUPERUSERS=["10001"]
# 主人昵称（群聊提示词里的显示名；缺省回落内置默认串，公开发行前务必覆盖为本机身份）
# OWNER_NICKNAME=主人昵称

# ---- 大脑层（OpenAI 兼容端点：llama-server / Ollama / vLLM 均可）----
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gemma  # 本地引擎默认模型名，仅作标识

# ---- 人格库 ----
# 使用 qq-bot/data/personas/<名字>.json 的角色卡
# ★ 出厂占位卡是 `_starter`（中性、随仓发布，保证"克隆下来就能跑"）。
#   换成你自己的：复制 `_starter.json`（或 `_template.json`）改名成 <你的卡名>.json，
#   再把下面这行改成 <你的卡名>；也可以直接私聊发 `/人设 卡名` 热切换（无需重启）。
#   ⚠️ 默认值**不要**写成 default 之类的名字却不建对应文件——加载器会按契约抛 FileNotFoundError。
PERSONA=_starter

# ---- LLM Provider 适配层（core/llm.py 统一解析；代码零改动）----
# 全部注释 = 维持本地 llama-server 现状；取消注释并填实际值即切换到外部端点。
# 协议不通的类型（Anthropic/Gemini 原生）请在本机跑协议代理，把代理地址填这里。
# ★ 型号名有保质期（2026-09-12 修正：DeepSeek 的 deepseek-chat 已停用，现行无版本号写法是
#   deepseek-flash ＝ V4.1 Flash）。**别照抄示例**——以服务商文档为准，或直接 GET {LLM_BASE_URL}/models
#   看现役清单（启动器「设置 → 模型与接口 → 拉取型号」按钮做的就是这件事）。
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-flash
# LLM_MODEL_FICTION=                     # llm_model_<用途> 专用模型，优先于 LLM_MODEL；留空=沿用 LLM_MODEL
# LLM_SMALL_BASE_URL=http://127.0.0.1:11434/v1
# LLM_CTX_BUDGET=32768
# LLM_THINKING_PARAM=auto                # auto | on | off | 供应商特有参数名
#                                        # 注：V4.1 时代"思考档"多由**参数**控制，而不是换一个 model 名
#                                        # （旧的 deepseek-reasoner 那种"另开一个模型名"的写法已不适用）

# ---- 记忆检索（向量）----
# EMBED_BASE_URL=http://127.0.0.1:11435/v1/embeddings
# EMBED_ENABLED=true

# ---- 表情包 ----
# 关掉 = 不发自带表情（图片与文字的视觉竞争，见 T13.4）
# STICKER_ENABLED=true
# 角色专属表情目录（缺省走通用库 qq-bot/data/stickers/_common/<9类情绪>/）
# STICKER_DIFF_DIR=

# ---- GAL 页（launcher WebView 的视觉小说界面）----
# 关掉 = 用 qq 聊天模式；开启后 GAL 页与聊天记录持久化
# WEBGAL_CHAT_PERSIST=false

# ---- Telegram 通道（国际 IM；2026-09-12 接入，海外没有 QQ 时的对话入口）----
# 缺省关闭 = 加载零副作用（不建连接、不打日志）。开启三步：
#   ① Telegram 里找 @BotFather → /newbot → 拿到 <数字>:<串> 形式的 token
#   ② 找 @userinfobot 发一条消息 → 拿到你自己的数字 id
#   ③ 填下面两行 + ENABLED 改 true → 重启 bot
# 中国大陆直连不了 api.telegram.org：填 TELEGRAM_PROXY（不填则用系统 HTTPS_PROXY）。
# v1 边界：仅私聊 + 仅主人；群聊与陌生人一律忽略（防"猜中 bot 用户名就当成你本人说话"）；
#         语音只入不出（见 docs/遗留任务.md A15）。
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_OWNER_ID=123456789
# TELEGRAM_PROXY=http://127.0.0.1:10808
# 自建反代才改（⚠️ 第三方反代能看到 token）；缺省官方端点
# TELEGRAM_API_BASE=https://api.telegram.org

# ---- 创作模块（小说/大纲）----
# FICTION_ENABLED=false

# ---- 直播投放（B 站弹幕 → 弹幕演出）----
# 开前先 pip install blivedm；缺依赖时自动保持禁用并留一行日志
# LIVE_DANMAKU_ENABLED=false
# 本机亲耳听语音调试通道（默认关＝零行为变化、零导入）
# LIVE_AUDIO_PLAYBACK=false

# ---- Live2D 演出（VTube Studio）----
# VTS_ENABLED=true 前请先安装并启动 VTube Studio（Steam），加载 Live2D 模型
VTS_ENABLED=false
VTS_HOST=127.0.0.1
VTS_PORT=8001
VTS_PLUGIN_NAME=QQAICompanion

# ---- 内容包 / 工具包 ----
# ★ 工具包（type=tool）里的 python 代码装载开关。**默认关闭**：关闭时连 import 都不做，
#   普通用户装数据包（人设/台词/立绘/世界观）零风险。开启等于信任该包代码——
#   内核级沙箱（AppContainer 子进程）见 docs/S4-沙盒与声明式权限-spec-2026-09-12.md。
# PACKS_ENABLE_PY=false

# ---- 测试/调试钩子 ----
# 覆盖记忆库路径（test_circadian.py 等注入临时库用；正常使用不要设）
# MEMORY_DB_PATH=
